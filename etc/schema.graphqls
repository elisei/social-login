type Mutation {
    # Solicita um código de verificação para ser enviado por email
    requestVerificationCode(
        email: String! @doc(description: "Email do cliente para enviar o código de verificação")
        referer: String @doc(description: "Página de referência (account, checkout, cart)")
    ): VerificationCodeResponse @resolver(class: "O2TI\\SocialLogin\\Model\\Resolver\\RequestVerificationCode")

    # Valida o código de verificação e realiza o login
    verifyCodeAndLogin(
        email: String! @doc(description: "Email do cliente")
        code: String! @doc(description: "Código de verificação recebido por email")
    ): VerifyCodeResponse @resolver(class: "O2TI\\SocialLogin\\Model\\Resolver\\VerifyCodeAndLogin")
}

# Resposta para a solicitação de código de verificação
type VerificationCodeResponse @doc(description: "Resposta da solicitação de código de verificação") {
    success: Boolean! @doc(description: "Indica se a solicitação foi bem-sucedida")
    message: String @doc(description: "Mensagem de sucesso ou erro")
}

# Resposta para a verificação de código e login
type VerifyCodeResponse @doc(description: "Resposta da verificação de código e login") {
    success: Boolean! @doc(description: "Indica se a verificação e login foram bem-sucedidos")
    message: String @doc(description: "Mensagem de sucesso ou erro")
    redirect: String @doc(description: "URL para redirecionamento após login bem-sucedido")
    customer_token: String @doc(description: "Token JWT do cliente para autenticação em requisições subsequentes")
}
